# ====================================================
# ORCA Marine Intelligence Platform - Environment Config
# ====================================================

# Core Application Settings
PROJECT_NAME="ORCA Marine Intelligence Backend"
VERSION="1.0.0"
DEBUG=False
HOST="0.0.0.0"
PORT=8000
ALLOWED_ORIGINS=["*"]

# Redis Cache Configuration
REDIS_URL="redis://localhost:6379/0"
CACHE_ENABLED=True
CACHE_TTL_SECONDS=900
SPATIAL_CACHE_PRECISION=2

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Marine Safety Thresholds
MAX_SAFE_WIND_SPEED_KNOTS=25.0
CAUTION_WIND_SPEED_KNOTS=18.0
MAX_SAFE_WAVE_HEIGHT_METERS=2.5
CAUTION_WAVE_HEIGHT_METERS=1.8
DANGEROUS_WAVE_HEIGHT_METERS=3.5
MAX_SAFE_GUST_KNOTS=30.0
MIN_VISIBILITY_KM=4.0

# Ocean Conditions & Potential Fishing Zone (PFZ)
MIN_OPTIMAL_SST_CELSIUS=26.0
MAX_OPTIMAL_SST_CELSIUS=30.5
MIN_CHLOROPHYLL_MG_M3=0.2
OPTIMAL_CHLOROPHYLL_MG_M3=0.6

# Geofence & Boundary Limits (Nautical Miles)
EEZ_WARNING_BUFFER_NM=5.0
EEZ_DANGER_BUFFER_NM=1.0

# Live Weather API Endpoints
OPEN_METEO_MARINE_API="https://marine-api.open-meteo.com/v1/marine"
OPEN_METEO_WEATHER_API="https://api.open-meteo.com/v1/forecast"
